SLACK_TOKEN=YOUR_TOKEN
SLACK_CHANNEL=YOUR_CHANNEL_ID
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# Optional: shift the release schedule by whole days (bank holidays).
# -1 = one day earlier (Thursday acts as Friday), 1 = one day later. Default 0.
# RELEASE_DAY_OFFSET=-1
# Optional: last day (inclusive, ISO date) the offset applies. Ignored after.
# RELEASE_DAY_OFFSET_UNTIL=2026-10-09
